# ==============================================================================
# H3 Studio - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Binary & Model Weights Paths
# ------------------------------------------------------------------------------
# Path to the compiled h3.c Metal binary (auto-detected under ./engines/h3.c/h3 if empty)
# H3_BIN_PATH=./engines/h3.c/h3

# Path to the MiniMax-H3 Base model weights (20-30 steps)
# H3_MODEL_DIR=./models/MiniMax-H3

# Path to the MiniMax-H3 Turbo folded LoRA weights (6 steps)
# H3_TURBO_MODEL_DIR=./models/MiniMax-H3-Turbo

# Output directory for rendered shots and merged videos
# H3_OUTPUT_DIR=./outputs

# Local ComfyUI directory (if using ComfyUI node integration)
# COMFY_DIR=./ComfyUI

# ------------------------------------------------------------------------------
# 2. Performance & Hardware Profiles
# ------------------------------------------------------------------------------
# Active Mode: 'turbo' (6 steps, 45-50 layers) or 'base' (20-30 steps, 45 layers)
H3_ACTIVE_MODE=turbo

# Video VAE Precision: 'bf16' (Apple Silicon M-series recommended) or 'int8'
H3_VAE_PRECISION=bf16

# Enable Video VAE Cache & Prefetch for faster chained decoding
H3_VAE_CACHE=1
H3_VAE_PREFETCH=1

# ------------------------------------------------------------------------------
# 3. Context-IR & Prompt Expansion
# ------------------------------------------------------------------------------
# Optional local OpenAI-compatible endpoint for Context-IR prompt expansion
# e.g., llama-server or Ollama running locally:
# LOCAL_LLM_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions

# ------------------------------------------------------------------------------
# 4. Google Drive Cloud Backup (Optional)
# ------------------------------------------------------------------------------
# Default Google Drive target folder name for automatic video backup
H3_GDRIVE_FOLDER=H3-Studio

# Opt-in for public view links (0=private backup [recommended], 1=anyone with link can read).
# WARNING: When set to 1, Google Drive may take 1-5 minutes to transcode videos before web playback.
H3_GDRIVE_PUBLIC_SHARE=0
