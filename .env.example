# ==============================================================================
# H3 Studio - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your local machine.
# ==============================================================================

# Path to the compiled h3.c Metal binary (optional; auto-detected if empty)
# H3_BIN_PATH=./engines/h3.c/h3

# Path to the MiniMax-H3 model weights directory (Text Encoder, DiT, VAE)
# H3_MODEL_DIR=./models/MiniMax-H3

# Local ComfyUI directory (if using ComfyUI integration)
# COMFY_DIR=./ComfyUI

# Optional: Local LLM Endpoint for Context-IR prompt expansion (e.g. llama-server or Ollama)
# LOCAL_LLM_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions

# Video VAE Precision: bf16 (default for Apple Silicon M-series) or int8
H3_VAE_PRECISION=bf16

# Enable Video VAE Cache & Prefetch for faster chained decoding
H3_VAE_CACHE=1
H3_VAE_PREFETCH=1
